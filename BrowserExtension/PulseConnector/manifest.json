{
  "manifest_version": 3,
  "name": "Codex Pulse Connector",
  "description": "Sends Claude Web quota percentages and reset times to Codex Pulse. Cookies never leave Chrome.",
  "version": "0.1.3",
  "minimum_chrome_version": "116",
  "permissions": ["alarms", "scripting", "storage", "tabs"],
  "host_permissions": [
    "https://claude.ai/*",
    "http://127.0.0.1:37421/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Codex Pulse Connector",
    "default_popup": "popup.html"
  }
}
